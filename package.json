{
  "name": "ckb-monitor",
  "version": "1.0.0",
  "description": "Live CKB on-chain monitor: subscribe to the public WebSocket, classify every transaction, and fire actions (alert/webhook/exec) on rules you care about.",
  "type": "module",
  "bin": {
    "ckb-monitor": "./ckb-monitor.mjs"
  },
  "main": "ckb-monitor.mjs",
  "scripts": {
    "start": "node ckb-monitor.mjs",
    "mainnet": "node ckb-monitor.mjs --net mainnet",
    "testnet": "node ckb-monitor.mjs --net testnet"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "ckb",
    "nervos",
    "blockchain",
    "monitor",
    "websocket",
    "xudt",
    "sudt",
    "mempool"
  ],
  "license": "MIT",
  "dependencies": {},
  "optionalDependencies": {
    "ws": "^8.18.0"
  }
}
